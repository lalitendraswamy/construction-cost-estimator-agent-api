# Copy to .env and fill in. Never commit .env.
# Keep comments on their OWN lines: Docker --env-file and hosting dashboards (Render)
# treat "VALUE   # comment" as the literal value.

# ---------- App ----------
# local | test | staging | production  (production disables /docs)
APP_ENV=local
APP_NAME=estimator-agent
LOG_LEVEL=INFO
# true in staging/production (machine-readable logs)
LOG_JSON=false
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Security ----------
ADMIN_API_KEY=change-me-long-random-string
RATE_LIMIT_CHAT=20/minute
# redis://host:6379 when running more than one replica
RATE_LIMIT_STORAGE_URI=memory://

# ---------- LLMs (LangChain init_chat_model "provider:model" strings) ----------
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# small: supervisor, intake, responder, contact, knowledge
LLM_SMALL_MODEL=google_genai:gemini-3.5-flash-lite
# strong: estimate explanation
LLM_STRONG_MODEL=google_genai:gemini-3.8-flash
# Optional, leave commented to use model defaults.
# Thinking level: minimal | low | medium | high
# LLM_SMALL_THINKING_LEVEL=low
# LLM_STRONG_THINKING_LEVEL=medium
# Gemini 3 recommends its default temperature; don't lower it
# LLM_SMALL_TEMPERATURE=1.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---------- Embeddings (RAG) ----------
EMBEDDINGS_MODEL=gemini-embedding-2
# must match the vector index (make indexes)
EMBEDDINGS_DIMENSIONS=768

# ---------- MongoDB Atlas (one database for local dev AND Render) ----------
# Atlas → Connect → Drivers. The same values go into the Render environment.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/
MONGODB_DB=estimator
VECTOR_INDEX_NAME=kb_vector_index

# ---------- Checkpointer ----------
# mongodb: conversations persist in Atlas (same as production) | memory: lost on restart
CHECKPOINTER=mongodb

# ---------- Business rules ----------
# 1 Cr
OWNER_APPROVAL_THRESHOLD_INR=10000000
DEFAULT_CITY=visakhapatnam
OWNER_NAME=Ravikumar
OWNER_EMAIL=owner@example.com
# country code + number, no "+"
OWNER_WHATSAPP=919999999999

# ---------- Notifications ----------
# console (log only) | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=estimator@example.com

# ---------- Observability (LangSmith) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=construction-estimator
