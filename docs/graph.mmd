---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	input(input)
	supervisor(supervisor)
	intake(intake)
	ask_user(ask_user)
	request_approval(request_approval)
	await_approval(await_approval)
	knowledge(knowledge)
	contact(contact)
	responder(responder)
	__end__([<p>__end__</p>]):::last
	__start__ --> input;
	ask_user --> intake;
	await_approval --> responder;
	contact --> responder;
	estimator\3aexplain -.-> request_approval;
	estimator\3aexplain -.-> responder;
	input --> supervisor;
	intake -.-> ask_user;
	intake -.-> estimator\3acompute_quantities;
	knowledge --> responder;
	request_approval --> await_approval;
	supervisor -.-> contact;
	supervisor -.-> intake;
	supervisor -.-> knowledge;
	supervisor -.-> responder;
	responder --> __end__;
	subgraph estimator
	estimator\3acompute_quantities(compute_quantities)
	estimator\3afetch_rates(fetch_rates)
	estimator\3aprice_line_items(price_line_items)
	estimator\3avalidate(validate)
	estimator\3aexplain(explain)
	estimator\3acompute_quantities --> estimator\3afetch_rates;
	estimator\3afetch_rates --> estimator\3aprice_line_items;
	estimator\3aprice_line_items --> estimator\3avalidate;
	estimator\3avalidate -.-> estimator\3aexplain;
	estimator\3avalidate -.-> estimator\3afetch_rates;
	end
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
